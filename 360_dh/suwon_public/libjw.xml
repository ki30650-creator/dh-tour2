<krpano version="1.22" title="">

	<include url="skin/vtourskin.xml" />
	<reservation enable="yes" url="https://www.suwonlib.go.kr/ct/"/>
	<layer name="skin_control_bar" visible="false" />
	<hotspot name="suwon"
	         url="skin/수원이.png"
	         ath="0"
	         atv="88"
	         rx="90"
	         scale="0.3"
	         keep="true"
	         zoom="true" />

<style name="hs_title_box"
       type="text"
       bg="true"
       bgcolor="0x000000"
       bgalpha="0.65"
       bgborder="false"
       roundedge="6"
       css="text-align:center; color:#FFFFFF; font-size:13px; font-weight:bold; padding:4px 8px;"
       vcenter="true"
       enabled="true"
       handcursor="true"
       edge="bottom"
       oy="-35" />
	<action name="add_permanent_title">
		if(title !== null AND title != '',
			txtadd(txt_name, 'txt_', get(name));
			addhotspot(get(txt_name));
			hotspot[get(txt_name)].loadstyle(hs_title_box);
			
			set(hotspot[get(txt_name)].ath, get(ath));
			set(hotspot[get(txt_name)].atv, get(atv));
			
			set(hotspot[get(txt_name)].html, get(title));
			
			set(hotspot[get(txt_name)].linkedscene, get(linkedscene));
			set(hotspot[get(txt_name)].onclick, 
				loadscene(get(linkedscene), null, MERGE, BLEND(0.7)); 
			);
		);
	</action>
<style name="menu_btn_style"
	       type="text"
	       bg="true"
	       bgcolor="0x111111"
	       bgalpha="0.80"
	       bgborder="1 0xFFFFFF 0.3"
	       roundedge="5"
	       css="color:#FFFFFF; font-size:14px; font-weight:bold; text-align:center; line-height:36px; cursor:pointer;"
	       height="36"
	       align="lefttop" />

	<style name="menu_item_style"
	       type="text"
	       bg="true"
	       bgcolor="0x222222"
	       bgalpha="0.90"
	       bgborder="1 0x444444 0.5"
	       roundedge="4"
	       css="color:#E0E0E0; font-size:13px; text-align:center; line-height:32px; cursor:pointer;"
	       height="32"
	       align="lefttop"
	       onover="set(bgcolor, 0x007ACC); set(css, 'color:#FFFFFF; font-size:13px; text-align:center; line-height:32px; cursor:pointer;');"
	       onout="set(bgcolor, 0x222222); set(css, 'color:#E0E0E0; font-size:13px; text-align:center; line-height:32px; cursor:pointer;');" />

