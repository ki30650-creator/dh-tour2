	<hotspot name="suwon"
	         url="skin/수원이.png"
	         ath="0"
	         atv="88"
	         rx="90"
	         scale="0.3"
	         keep="true"
	         zoom="true" />
	<style name="hs_title_box"
	       type="text"
	       bg="true"
	       bgcolor="0x000000"
	       bgalpha="0.65"
	       bgborder="false"
	       roundedge="6"
	       css="text-align:center; color:#FFFFFF; font-size:13px; font-weight:bold; padding:4px 8px;"
	       vcenter="true"
	       enabled="true"
	       handcursor="true"
	       edge="bottom"
	       oy="-35" />

	<action name="add_permanent_title">
		if(title !== null AND title != '',
			txtadd(txt_name, 'txt_', get(name));
			addhotspot(get(txt_name));
			hotspot[get(txt_name)].loadstyle(hs_title_box);
			
			set(hotspot[get(txt_name)].ath, get(ath));
			set(hotspot[get(txt_name)].atv, get(atv));
			
			set(hotspot[get(txt_name)].html, get(title));
			
			set(hotspot[get(txt_name)].linkedscene, get(linkedscene));
			set(hotspot[get(txt_name)].onclick, 
				loadscene(get(linkedscene), null, MERGE, BLEND(0.7)); 
			);
		);
	</action>

	<layer name="skin_control_bar" visible="false" />

	<!-- 1. 스타일 설정 -->
	<style name="wedding_btn" 
	       type="text" width="115" height="34" 
	       bgcolor="0xFFFFFF" bgalpha="0.35" bgborder="false" roundedge="6" 
	       css="text-align:center; color:#FFFFFF; font-size:14px; font-weight:bold; line-height:34px;" 
	       vcenter="true" handcursor="true" />

	<style name="wedding_btn_mobile" 
	       type="text" width="65" height="26" 
	       bgcolor="0xFFFFFF" bgalpha="0.35" bgborder="false" roundedge="6" 
	       css="text-align:center; color:#FFFFFF; font-size:11px; font-weight:bold; line-height:26px;" 
	       vcenter="true" handcursor="true" />

	<!-- 2. 모바일 토글 동작 액션 -->
	<action name="toggle_wedding_mobile_menu">
		if(layer[menu_mobile_wedding].state == 'open',
			<!-- 메뉴 닫기 -->
			set(layer[menu_mobile_wedding].state, 'closed');
			set(layer[mobile_toggle_btn].html, '▲');
			tween(layer[menu_mobile_wedding].y, -52, 0.3);
			set(layer[wedding_mobile_content].visible, false);
		  ,
			<!-- 메뉴 열기 -->
			set(layer[menu_mobile_wedding].state, 'open');
			set(layer[mobile_toggle_btn].html, '▼');
			tween(layer[menu_mobile_wedding].y, 10, 0.3);
			set(layer[wedding_mobile_content].visible, true);
		);
	</action>

	<!-- 3. 버튼 선택 및 색상 변경 액션 -->
	<action name="select_wedding_btn">
		<!-- 데스크톱 버튼 초기화 -->
		set(layer[btn_parking].bgcolor, 0xFFFFFF); set(layer[btn_parking].bgalpha, 0.35);
		set(layer[btn_culture].bgcolor, 0xFFFFFF); set(layer[btn_culture].bgalpha, 0.35);
		set(layer[btn_exit].bgcolor, 0xFFFFFF);    set(layer[btn_exit].bgalpha, 0.35);
		set(layer[btn_banquet].bgcolor, 0xFFFFFF); set(layer[btn_banquet].bgalpha, 0.35);

		<!-- 모바일 버튼 초기화 -->
		set(layer[m_btn_parking].bgcolor, 0xFFFFFF); set(layer[m_btn_parking].bgalpha, 0.35);
		set(layer[m_btn_culture].bgcolor, 0xFFFFFF); set(layer[m_btn_culture].bgalpha, 0.35);
		set(layer[m_btn_exit].bgcolor, 0xFFFFFF);    set(layer[m_btn_exit].bgalpha, 0.35);
		set(layer[m_btn_banquet].bgcolor, 0xFFFFFF); set(layer[m_btn_banquet].bgalpha, 0.35);

		<!-- 선택된 버튼 활성화 -->
		if(layer[%1],
			set(layer[%1].bgcolor, 0x8B5A2B);
			set(layer[%1].bgalpha, 1.0);
		);

		txtadd(m_btn_name, 'm_', %1);
		if(layer[get(m_btn_name)],
			set(layer[get(m_btn_name)].bgcolor, 0x8B5A2B);
			set(layer[get(m_btn_name)].bgalpha, 1.0);
		);
	</action>

	<!-- 4. [데스크톱] 상단 메뉴 BAR -->
	<layer name="topmenu_wedding" type="container" keep="true" align="centertop" x="0" y="20" width="520" height="88" bgcolor="0x000000" bgalpha="0.45" roundedge="12" devices="desktop">
		<layer name="wedding_title" type="text" align="top" y="10" html="전통혼례체험관" css="text-align:center; color:#FFFFFF; font-size:16px; font-weight:bold; letter-spacing:1px;" bg="false" vcenter="true" handcursor="true" 
		       onclick="loadscene(scene_wedding_j_6, null, MERGE, BLEND(0.7));"/>

