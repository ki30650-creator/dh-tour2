<krpano version="1.22" >

	<include url="skin/vtourskin.xml" />
	<reservation enable="no" />

	<plugin name="scrollarea" url="%SWFPATH%/plugins/scrollarea.js" keep="true" />

	<!-- 무궁화원 전용 버튼 기본 스타일 정의 -->
	<style name="mugunghwa_btn" 
	       type="text" 
	       width="110" 
	       height="32" 
	       bgcolor="0xFFFFFF" 
	       bgalpha="0.35" 
	       border="false" 
	       roundedge="8" 
	       css="text-align:center; color:#FFFFFF; font-size:13px; font-weight:bold; line-height:32px;" 
	       vcenter="true" 
	       handcursor="true" />

	<!-- 버튼 활성화/비활성화 상태 제어 액션 -->
	<action name="select_mugunghwa_btn">
		<!-- 전체 버튼 초기화 -->
		set(layer[btn_mgh_main].bgcolor, 0xFFFFFF); set(layer[btn_mgh_main].bgalpha, 0.35);
		set(layer[btn_mgh_parking].bgcolor, 0xFFFFFF); set(layer[btn_mgh_parking].bgalpha, 0.35);
		set(layer[btn_mgh_route].bgcolor, 0xFFFFFF); set(layer[btn_mgh_route].bgalpha, 0.35);
		set(layer[btn_mgh_lovers].bgcolor, 0xFFFFFF); set(layer[btn_mgh_lovers].bgalpha, 0.35);

		<!-- 선택한 버튼만 포인트 컬러 설정 -->
		if(layer[%1],
			set(layer[%1].bgcolor, 0x2E8B57);
			set(layer[%1].bgalpha, 1.0);
		);
	</action>

	<!-- 모바일 / 데스크톱 반응형 처리 액션 -->
	<action name="update_mobile_menu_layout">
		if(stagewidth LT 540,
			<!-- 모바일 화면 (화면 폭 540px 미만) -->
			set(layer[topmenu_mugunghwa].width, calc(stagewidth - 20));
			
			<!-- 버튼 너비 및 위치 자동 계산 (4개 버튼 균등 배치) -->
			def(btn_w, number, calc((stagewidth - 50) / 4));
			if(btn_w LT 65, set(btn_w, 65));
			
			set(layer[btn_mgh_main].width, get(btn_w));
			set(layer[btn_mgh_parking].width, get(btn_w));
			set(layer[btn_mgh_route].width, get(btn_w));
			set(layer[btn_mgh_lovers].width, get(btn_w));
			
			set(layer[btn_mgh_main].x, 10);
			set(layer[btn_mgh_parking].x, calc(10 + btn_w + 5));
			set(layer[btn_mgh_route].x, calc(10 + (btn_w + 5) * 2));
			set(layer[btn_mgh_lovers].x, calc(10 + (btn_w + 5) * 3));

			<!-- 폰트 크기 및 줄높이 모바일 맞춤 조정 -->
			set(layer[btn_mgh_main].css, "text-align:center; color:#FFFFFF; font-size:11px; font-weight:bold; line-height:32px;");
			set(layer[btn_mgh_parking].css, "text-align:center; color:#FFFFFF; font-size:11px; font-weight:bold; line-height:32px;");
			set(layer[btn_mgh_route].css, "text-align:center; color:#FFFFFF; font-size:11px; font-weight:bold; line-height:32px;");
			set(layer[btn_mgh_lovers].css, "text-align:center; color:#FFFFFF; font-size:11px; font-weight:bold; line-height:32px;");
		,
			<!-- 데스크톱 / 태블릿 화면 -->
			set(layer[topmenu_mugunghwa].width, 520);
			
			set(layer[btn_mgh_main].width, 110);
			set(layer[btn_mgh_parking].width, 110);
			set(layer[btn_mgh_route].width, 110);
			set(layer[btn_mgh_lovers].width, 110);

			set(layer[btn_mgh_main].x, 15);
			set(layer[btn_mgh_parking].x, 140);
			set(layer[btn_mgh_route].x, 265);
			set(layer[btn_mgh_lovers].x, 390);

			set(layer[btn_mgh_main].css, "text-align:center; color:#FFFFFF; font-size:13px; font-weight:bold; line-height:32px;");
			set(layer[btn_mgh_parking].css, "text-align:center; color:#FFFFFF; font-size:13px; font-weight:bold; line-height:32px;");
			set(layer[btn_mgh_route].css, "text-align:center; color:#FFFFFF; font-size:13px; font-weight:bold; line-height:32px;");
			set(layer[btn_mgh_lovers].css, "text-align:center; color:#FFFFFF; font-size:13px; font-weight:bold; line-height:32px;");
		);
	</action>

	<!-- 화면 크기 변경 시 및 로드 시 레이아웃 자동 업데이트 이벤트 -->
	<events name="mugunghwa_resize_events" 
	        keep="true" 
	        onresize="update_mobile_menu_layout();" 
	        onloadcomplete="update_mobile_menu_layout();" />

	<!-- Top 메뉴 컨테이너 (무궁화원용) -->
	<layer name="topmenu_mugunghwa" type="container" keep="true" align="centertop" x="0" y="20" width="520" height="95" bgcolor="0x000000" bgalpha="0.35" roundedge="18" >
		<layer name="title" 
		       type="text" 
		       align="top" 
		       y="12" 
		       html="수원 무궁화원" 
		       css="text-align:center; color:#FFFFFF; font-size:16px; font-weight:bold; letter-spacing:1px;" 
		       bg="false" 
		       vcenter="true" 
		       handcursor="true" 
		       onclick="select_mugunghwa_btn('none'); loadscene(scene_Hibiscus_1,null,MERGE,BLEND(0.7));"/>

		<!-- 메뉴 버튼 모음 -->
		<layer name="btn_mgh_main" style="mugunghwa_btn" x="15" y="48" html="무궁화원"  
		       onclick="select_mugunghwa_btn('btn_mgh_main'); loadscene(scene_Hibiscus_1,null,MERGE,BLEND(0.7));"/>

		<layer name="btn_mgh_parking" style="mugunghwa_btn" x="140" y="48" html="주차장" 
		       onclick="select_mugunghwa_btn('btn_mgh_parking'); loadscene(scene_Hibiscus_3,null,MERGE,BLEND(0.7));"/>

		<layer name="btn_mgh_route" style="mugunghwa_btn" x="265" y="48" html="관람동선" 
		       onclick="select_mugunghwa_btn('btn_mgh_route'); loadscene(scene_Hibiscus_4,null,MERGE,BLEND(0.7));"/>

		<layer name="btn_mgh_lovers" style="mugunghwa_btn" x="390" y="48" html="연인의 길" 
		       onclick="select_mugunghwa_btn('btn_mgh_lovers'); loadscene(scene_Hibiscus_5,null,MERGE,BLEND(0.7));"/>
	</layer>

	<layer name="skin_control_bar" visible="false" />

	<style name="hs_title_box"
	       type="text"
	       bg="true"
	       bgcolor="0x000000"
	       bgalpha="0.65"
	       bgborder="false"
	       roundedge="6"
	       css="text-align:center; color:#FFFFFF; font-size:13px; font-weight:bold; padding:4px 8px;"
	       vcenter="true"
	       enabled="true"
	       handcursor="true"
	       edge="bottom"
	       oy="-35" />

	<action name="add_permanent_title">
		if(title !== null AND title != '',
			txtadd(txt_name, 'txt_', get(name));
			addhotspot(get(txt_name));
			hotspot[get(txt_name)].loadstyle(hs_title_box);
			
			set(hotspot[get(txt_name)].ath, get(ath));
			set(hotspot[get(txt_name)].atv, get(atv));
			
			set(hotspot[get(txt_name)].html, get(title));
			
			set(hotspot[get(txt_name)].linkedscene, get(linkedscene));
			set(hotspot[get(txt_name)].onclick, 
				loadscene(get(linkedscene), null, MERGE, BLEND(0.7)); 
			);
		);
	</action>

