<krpano version="1.22" >

	<include url="skin/vtourskin.xml" />
<reservation enable="no" url="https://www.namsuheon.kr/main/" />

<plugin name="scrollarea" url="%SWFPATH%/plugins/scrollarea.js" keep="true" />

    <layer name="skin_control_bar" visible="false" />

    <style name="hs_title_box"
           type="text"
           bg="true"
           bgcolor="0x000000"
           bgalpha="0.65"
           bgborder="false"
           roundedge="6"
           css="text-align:center; color:#FFFFFF; font-size:13px; font-weight:bold; padding:4px 8px;"
           vcenter="true"
           enabled="true"
           handcursor="true"
           edge="bottom"
           oy="-35" />

<action name="add_permanent_title">
    <!-- title 속성이 존재하고, 빈 값이 아닐 때만 텍스트 핫스팟 생성 -->
    if(title !== null AND title != '',
        <!-- 텍스트 박스 고유 이름 생성 및 핫스팟 추가 -->
        txtadd(txt_name, 'txt_', get(name));
        addhotspot(get(txt_name));
        hotspot[get(txt_name)].loadstyle(hs_title_box);
        
        <!-- 위치 좌표(ath, atv) 동기화 -->
        set(hotspot[get(txt_name)].ath, get(ath));
        set(hotspot[get(txt_name)].atv, get(atv));
        
        <!-- 현재 핫스팟의 title 속성값 적용 -->
        set(hotspot[get(txt_name)].html, get(title));
        
        <!-- 텍스트 박스 클릭 시 linkedscene 이동 및 동작 설정 -->
        set(hotspot[get(txt_name)].linkedscene, get(linkedscene));
        set(hotspot[get(txt_name)].onclick, 
            loadscene(get(linkedscene), null, MERGE, BLEND(0.7)); 
        );
    );
</action>

